# Python
__pycache__/
*.pyc
.pytest_cache/

# Virtual environment
venv/

# macOS
.DS_Store

# VS Code
.vscode/

# Logs
*.log

# Environment variables. ⚠️ The glob matters: `.env` alone matches ONLY that exact filename, so
# `.env.staging` — the file the Supabase staging runbook asks you to create — was committable. On a PUBLIC
# repo that is a credential leak one `git add -A` away (ADR-211 / docs/SUPABASE_STAGING.md).
.env
.env.*
# …but the template must be committable — it holds placeholders, not credentials.
!.env.*.example

# ⚠️ Streamlit secrets — NEVER commit. The repo is PUBLIC (Streamlit Community Cloud requires it), and this
# file is where the Supabase anon key and the Google `[auth]` client secret live when testing locally.
# Only `.env` was listed here, which covered a file this project does not use and missed the one it does.
.streamlit/secrets.toml
**/secrets.toml

# Local database (generated cache, not source)
data/*.db
# …except the committed public-deploy snapshot (ADR-053):
!data/seed.db

# Editable-install build metadata (`pip install -e .`) — generated, not source
*.egg-info/

# Saved squads — the user's own state, not source (ADR-024)
data/*.json

# Claude Code local settings
.claude/settings.local.json

# seleniumbase/soccerdata spike cruft (never committed)
downloaded_files/
.ruff_cache/
# …except the committed demo squads (ADR-054):
!data/seed_squads.json
